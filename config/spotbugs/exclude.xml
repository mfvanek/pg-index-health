<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Bug
            pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,CT_CONSTRUCTOR_THROW,EXS_EXCEPTION_SOFTENING_NO_CONSTRAINTS,EXS_EXCEPTION_SOFTENING_NO_CHECKED,IMC_IMMATURE_CLASS_NO_TOSTRING,IMC_IMMATURE_CLASS_NO_EQUALS,OPM_OVERLY_PERMISSIVE_METHOD"/>
    </Match>
    <Match>
        <Bug pattern="NSE_NON_SYMMETRIC_EQUALS"/>
        <Class name="io.github.mfvanek.pg.connection.PgConnectionImpl"/>
    </Match>
    <Match>
        <Bug pattern="WEM_WEAK_EXCEPTION_MESSAGING,PRMC_POSSIBLY_REDUNDANT_METHOD_CALLS,AI_ANNOTATION_ISSUES_NEEDS_NULLABLE,PSC_PRESIZE_COLLECTIONS"/>
    </Match>
    <Match>
        <Bug pattern="SIL_SQL_IN_LOOP,SQL_INJECTION_JDBC,CLI_CONSTANT_LIST_INDEX,IMPROPER_UNICODE,MDM_THREAD_YIELD"/>
    </Match>
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Class name="io.github.mfvanek.pg.health.checks.cluster.UnusedIndexesCheckOnCluster"/>
    </Match>
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD"/>
        <Class name="io.github.mfvanek.pg.testing.PostgreSqlClusterAliasHolder"/>
    </Match>
    <Match>
        <Bug pattern="OCP_OVERLY_CONCRETE_PARAMETER"/>
        <Or>
            <Class name="io.github.mfvanek.pg.model.constraint.DuplicatedForeignKeys"/>
            <Class name="io.github.mfvanek.pg.model.index.DuplicatedIndexes"/>
        </Or>
    </Match>
    <Match>
        <Bug pattern="STT_STRING_PARSING_A_FIELD"/>
        <Class name="io.github.mfvanek.pg.testing.PostgresVersionHolder"/>
    </Match>
    <Match>
        <Bug pattern="UCPM_USE_CHARACTER_PARAMETERIZED_METHOD"/>
        <Class name="io.github.mfvanek.pg.generator.PgIdentifierNameGenerator"/>
    </Match>
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
        <Class name="io.github.mfvanek.pg.core.fixtures.support.statements.AbstractDbStatement"/>
    </Match>
    <Match>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE,SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING,EXS_EXCEPTION_SOFTENING_HAS_CHECKED"/>
        <Class name="~io\.github\.mfvanek\.pg\.core\.fixtures\.support\..*"/>
    </Match>
    <Match>
        <Bug pattern="ACEM_ABSTRACT_CLASS_EMPTY_METHODS"/>
        <Class name="io.github.mfvanek.pg.core.fixtures.support.statements.AbstractDbStatement"/>
    </Match>
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_THROWABLE,RFI_SET_ACCESSIBLE"/>
        <Class name="io.github.mfvanek.pg.model.fixtures.support.TestUtils"/>
    </Match>
    <!--
    <Match>
        <Bug pattern="EC_NULL_ARG,EC_UNRELATED_TYPES,EC_UNRELATED_CLASS_AND_INTERFACE,NM_CONFUSING,NP_NONNULL_PARAM_VIOLATION,DP_DO_INSIDE_DO_PRIVILEGED,UVA_POSSIBLE_EXCESS_NULL"/>
        <Class name="~.*Test"/>
    </Match>
    <Match>
        <Bug pattern="DP_CREATE_CLASSLOADER_INSIDE_DO_PRIVILEGED"/>
        <Class name="io.github.mfvanek.pg.spring.DatabaseStructureHealthAutoConfigurationFilteringTest"/>
    </Match>
    <Match>
        <Bug pattern="PDP_POORLY_DEFINED_PARAMETER"/>
        <Class name="io.github.mfvanek.pg.spring.AutoConfigurationTestBase"/>
    </Match>
    -->
</FindBugsFilter>
